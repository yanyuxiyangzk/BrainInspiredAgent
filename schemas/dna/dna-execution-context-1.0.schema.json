{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bia.local/schemas/dna/dna-execution-context-1.0.schema.json",
  "title": "BIA DNA Execution Context 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization", "organization_role", "agent", "workflow", "context_digest", "responsibility"],
  "properties": {
    "organization": {"$ref": "#/$defs/identity"},
    "organization_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "agent": {"$ref": "#/$defs/identity"},
    "workflow": {"$ref": "#/$defs/identity"},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "responsibility": {"type": "string", "minLength": 1, "maxLength": 200}
  },
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["dna_id", "version", "content_digest"],
      "properties": {
        "dna_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}

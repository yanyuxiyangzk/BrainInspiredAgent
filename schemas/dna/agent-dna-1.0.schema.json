{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bia.local/schemas/dna/agent-dna-1.0.schema.json",
  "title": "BrainAgent Agent DNA 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["dna_spec_version", "dna_id", "version", "kind", "status", "content_digest", "envelope_digest", "profile", "workflow_dna", "generator"],
  "properties": {
    "dna_spec_version": {"const": "1.0"},
    "dna_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kind": {"const": "AGENT"},
    "status": {"enum": ["CANDIDATE", "VALIDATED", "SHADOW", "CANARY", "ACTIVE", "DEPRECATED", "RETIRED"]},
    "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "envelope_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["goal", "attention", "planning", "memory", "evaluation"],
      "properties": {
        "goal": {"type": "object", "additionalProperties": false, "required": ["allowed_goal_types", "max_active_goals", "default_priority"], "properties": {"allowed_goal_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "max_active_goals": {"type": "integer", "minimum": 1}, "default_priority": {"type": "number", "minimum": 0, "maximum": 1}}},
        "attention": {"type": "object", "additionalProperties": false, "required": ["salience_weights", "max_focus_items", "switch_threshold"], "properties": {"salience_weights": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0}}, "max_focus_items": {"type": "integer", "minimum": 1}, "switch_threshold": {"type": "number", "minimum": 0, "maximum": 1}}},
        "planning": {"type": "object", "additionalProperties": false, "required": ["strategy", "horizon_seconds", "max_tasks"], "properties": {"strategy": {"enum": ["REACTIVE", "DELIBERATIVE", "HYBRID"]}, "horizon_seconds": {"type": "integer", "minimum": 1}, "max_tasks": {"type": "integer", "minimum": 1}}},
        "memory": {"type": "object", "additionalProperties": false, "required": ["working_items", "episodic_retention_days", "semantic_candidates"], "properties": {"working_items": {"type": "integer", "minimum": 1}, "episodic_retention_days": {"type": "integer", "minimum": 1}, "semantic_candidates": {"type": "integer", "minimum": 1}}},
        "evaluation": {"type": "object", "additionalProperties": false, "required": ["minimum_evidence_score", "minimum_value_score", "review_interval_seconds"], "properties": {"minimum_evidence_score": {"type": "number", "minimum": 0, "maximum": 1}, "minimum_value_score": {"type": "number", "minimum": 0, "maximum": 1}, "review_interval_seconds": {"type": "integer", "minimum": 1}}}
      }
    },
    "workflow_dna": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["role", "dna_id", "version", "content_digest"], "properties": {"role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}, "dna_id": {"type": "string"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}},
    "generator": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}

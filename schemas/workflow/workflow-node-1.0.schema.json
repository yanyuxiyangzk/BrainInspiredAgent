{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bia.local/schemas/workflow/workflow-node-1.0.schema.json",
  "title": "BIA Workflow Node 1.0",
  "oneOf": [
    {"$ref": "#/$defs/skill"},
    {"$ref": "#/$defs/condition"},
    {"$ref": "#/$defs/parallel"},
    {"$ref": "#/$defs/delay"},
    {"$ref": "#/$defs/subWorkflow"}
  ],
  "$defs": {
    "nodeId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "dependsOn": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
    "retry": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "backoff_seconds", "retry_on"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "backoff_seconds": {"type": "number", "minimum": 0, "maximum": 60},
        "retry_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}}
      }
    },
    "common": {
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"},
        "depends_on": {"$ref": "#/$defs/dependsOn"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "input": {"type": "object"},
        "retry": {"$ref": "#/$defs/retry"}
      }
    },
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "type", "depends_on", "capability", "capability_version", "input", "constraints"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"}, "type": {"const": "skill"}, "depends_on": {"$ref": "#/$defs/dependsOn"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300}, "retry": {"$ref": "#/$defs/retry"},
        "capability": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"},
        "capability_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$"},
        "input": {"type": "object"},
        "constraints": {
          "type": "object", "additionalProperties": false,
          "required": ["side_effect"],
          "properties": {
            "side_effect": {"enum": ["PURE", "IDEMPOTENT", "QUERYABLE", "NON_REPLAYABLE"]},
            "max_latency_ms": {"type": "integer", "minimum": 1},
            "freshness_seconds": {"type": "integer", "minimum": 0},
            "required_permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "output_schema_ref": {"type": "string"}, "idempotency_key": {"type": "string", "maxLength": 255}
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "type", "depends_on", "expression", "then", "else"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"}, "type": {"const": "condition"}, "depends_on": {"$ref": "#/$defs/dependsOn"},
        "expression": {"type": "string", "minLength": 1, "maxLength": 1000},
        "then": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}},
        "else": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}}
      }
    },
    "parallel": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "type", "depends_on", "branches", "failure_policy"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"}, "type": {"const": "parallel"}, "depends_on": {"$ref": "#/$defs/dependsOn"},
        "branches": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeId"}}},
        "failure_policy": {"enum": ["fail_fast", "collect_all", "min_success"]},
        "min_success": {"type": "integer", "minimum": 1}
      },
      "allOf": [{"if": {"properties": {"failure_policy": {"const": "min_success"}}}, "then": {"required": ["min_success"]}}]
    },
    "delay": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "type", "depends_on"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"}, "type": {"const": "delay"}, "depends_on": {"$ref": "#/$defs/dependsOn"},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}, "until": {"type": "string", "format": "date-time"}
      },
      "oneOf": [{"required": ["duration_seconds"]}, {"required": ["until"]}]
    },
    "subWorkflow": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "type", "depends_on", "workflow_id", "workflow_version", "input", "failure_policy"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"}, "type": {"const": "sub_workflow"}, "depends_on": {"$ref": "#/$defs/dependsOn"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "workflow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "workflow_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "input": {"type": "object"}, "failure_policy": {"enum": ["propagate", "continue", "compensate"]},
        "compensation_node": {"$ref": "#/$defs/nodeId"}
      },
      "allOf": [{"if": {"properties": {"failure_policy": {"const": "compensate"}}}, "then": {"required": ["compensation_node"]}}]
    }
  }
}

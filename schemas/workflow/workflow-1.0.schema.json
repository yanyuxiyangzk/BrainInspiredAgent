{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bia.local/schemas/workflow/workflow-1.0.schema.json",
  "title": "BIA Workflow 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "workflow_id", "version", "name", "input_schema", "policy", "nodes", "output_mapping"],
  "properties": {
    "spec_version": {"const": "1.0"},
    "workflow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 1000},
    "input_schema": {"type": "object"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_parallelism", "required_capabilities"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_parallelism": {"type": "integer", "minimum": 1, "maximum": 32},
        "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "nodes": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "workflow-node-1.0.schema.json"}},
    "output_mapping": {"type": "object"}
  }
}

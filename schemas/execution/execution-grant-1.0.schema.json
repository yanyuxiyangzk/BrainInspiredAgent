{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bia.local/schemas/execution/execution-grant-1.0.schema.json",
  "title": "BIA Execution Grant 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "decision_id", "plan_id", "task_id", "workflow", "bindings", "policy_version", "world_snapshot_id", "memory_snapshot_id", "allowed_permissions", "budget", "issued_at", "expires_at", "consumption", "correlation_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "grant_id": {"type": "string", "format": "uuid"},
    "decision_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": "string", "format": "uuid"},
    "workflow": {"type": "object", "required": ["workflow_id", "version", "digest"], "properties": {"workflow_id": {"type": "string"}, "version": {"type": "string"}, "digest": {"type": "string"}}, "additionalProperties": false},
    "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "../skill/skill-binding-1.0.schema.json"}},
    "policy_version": {"type": "string"},
    "world_snapshot_id": {"type": "string"},
    "memory_snapshot_id": {"type": "string"},
    "allowed_permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_duration_seconds", "max_tokens", "max_cost_minor", "currency"], "properties": {"max_duration_seconds": {"type": "integer", "minimum": 1}, "max_tokens": {"type": "integer", "minimum": 0}, "max_cost_minor": {"type": "integer", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "consumption": {"const": "SINGLE_TASK_MULTI_ATTEMPT"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "dna_context": {"$ref": "../dna/dna-execution-context-1.0.schema.json"}
  }
}

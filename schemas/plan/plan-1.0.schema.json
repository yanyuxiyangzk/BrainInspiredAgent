{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bia.local/schemas/plan/plan-1.0.schema.json",
  "title": "BIA Candidate Plan 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "status", "created_at", "expires_at",
    "correlation_id", "trigger", "goal", "reason", "evidence",
    "tasks", "requested_budget", "policy_context"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "format": "uuid"},
    "status": {"const": "CANDIDATE"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_id", "occurred_at"],
      "properties": {
        "type": {"enum": ["SCHEDULE", "SALIENT_EVENT", "EXTERNAL_COMMAND", "GOAL", "RECOVERY"]},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "occurred_at": {"type": "string", "format": "date-time"}
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "priority"],
      "properties": {
        "goal_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "id"],
        "properties": {
          "type": {"enum": ["MESSAGE", "MEMORY", "RULE", "COMMAND", "SCHEDULE"]},
          "id": {"type": "string", "minLength": 1, "maxLength": 200},
          "summary": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/taskRequest"}
    },
    "requested_budget": {"$ref": "#/$defs/budget"},
    "dna_context": {"$ref": "../dna/dna-execution-context-1.0.schema.json"},
    "policy_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brain_mode", "market_phase", "data_fresh_until"],
      "properties": {
        "brain_mode": {"enum": ["BOOTING", "NORMAL", "REVIEW", "DEGRADED", "SAFE", "SHUTTING_DOWN"]},
        "market_phase": {"enum": ["PRE_OPEN", "AUCTION", "TRADING", "CLOSED", "HOLIDAY"]},
        "data_fresh_until": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "taskRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "workflow_id", "workflow_version", "params", "priority",
        "deadline", "idempotency_key", "depends_on"
      ],
      "properties": {
        "task_id": {"type": "string", "format": "uuid"},
        "workflow_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "workflow_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "params": {"type": "object"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "deadline": {"type": "string", "format": "date-time"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 255},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "uuid"}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_cost_minor", "currency", "max_duration_seconds"],
      "properties": {
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_cost_minor": {"type": "integer", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    }
  }
}

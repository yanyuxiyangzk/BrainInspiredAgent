{
  "name": "bia-docs-viewer",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "docs:build": "esbuild docs-site/app.js --bundle --format=esm --minify --outfile=docs-site/app.bundle.js",
    "docs:serve": "npm run docs:build && node scripts/serve-docs.mjs",
    "docs:check": "npm run docs:build && node scripts/check-docs.mjs"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "katex": "0.17.0",
    "marked-alert": "2.1.2",
    "marked-footnote": "1.4.0",
    "marked-highlight": "2.2.4",
    "marked-katex-extension": "5.1.10",
    "mermaid": "11.16.1",
    "marked": "15.0.12"
  }
}
